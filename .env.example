# Testnet only. Generate your own keys; never reuse them on mainnet.
# Sui operator: sponsors user gas, pays for inbound mints, holds the CorridorAdminCap.
OPERATOR_SECRET_KEY=suiprivkey1...
# EVM relayer: pays Base Sepolia gas for outbound mints. It is the CCTP destination caller.
RELAYER_EVM_KEY=0x...
# Optional demo users for pnpm send / pnpm inbound / pnpm e2e.
DEMO_SUI_KEY=suiprivkey1...
DEMO_EVM_KEY=0x...
BASE_SEPOLIA_RPC=https://sepolia.base.org
